rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && profile().get('status', 'active') != 'suspended'; }
    // Email ownership is required; merely registering someone else's email grants nothing.
    function developer() { return signedIn() && request.auth.token.email_verified == true && request.auth.token.email == 'tikfese@gmail.com'; }
    function admin() { return active() && (developer() || profile().role == 'admin'); }
    function seller() { return active() && profile().role == 'seller'; }
    function changedOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }
    function text(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    function registrationOpen(role) {
      let path = /databases/$(database)/documents/settings/platform;
      return !exists(path) || (get(path).data.get('registrationOpen', true) == true && (role != 'seller' || get(path).data.get('newSellerApplications', true) == true));
    }
    match /users/{uid} {
      allow get: if self(uid) || admin();
      allow list: if admin();
      allow create: if self(uid) && registrationOpen(request.resource.data.role)
        && request.resource.data.keys().hasOnly(['name','email','phone','role','district','verified','joinedAt','sellerCategory','bio','sellerType','businessName','avatarUrl','totalOrders','totalEarnings','createdAt','updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['buyer','seller']
        && request.resource.data.verified == false
        && request.resource.data.totalOrders == 0 && request.resource.data.totalEarnings == 0
        && text(request.resource.data.name, 100);
      allow update: if (self(uid) && active()
        && changedOnly(['name','phone','district','bio','sellerCategory','businessName','avatarUrl','website','facebook','instagram','availability','workDays','startTime','endTime','responseTime','notificationPreferences','updatedAt'])
        && text(request.resource.data.name, 100))
        || (admin() && resource.data.role != 'developer'
          && changedOnly(['status','verified','updatedAt']))
        || (developer() && changedOnly(['role','status','verified','updatedAt']) && request.resource.data.role in ['buyer','seller','admin']);
      allow delete: if false; // Account/data deletion requires the trusted server retention workflow.
      match /saved/{serviceId} { allow read, write: if self(uid) && active(); }
      match /notifications/{notificationId} {
        allow read: if self(uid) && active();
        allow update: if self(uid) && active() && changedOnly(['read']) && request.resource.data.read is bool;
        allow create, delete: if false;
      }
    }
    match /verifications/{uid} {
      allow read: if self(uid) || admin();
      allow create: if self(uid) && seller() && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['status','idType','identityNumber','businessRegistration','taxNumber','documents','experience','skills','teamSize','website','address','submittedAt'])
        && request.resource.data.documents is list && request.resource.data.documents.size() >= 2 && request.resource.data.documents.size() <= 3;
      allow update: if (admin() && changedOnly(['status','notes','reviewedAt']))
        || (self(uid) && seller() && resource.data.status in ['pending','rejected'] && request.resource.data.status == 'pending'
          && changedOnly(['status','idType','identityNumber','businessRegistration','taxNumber','documents','experience','skills','teamSize','website','address','submittedAt'])
          && request.resource.data.documents is list && request.resource.data.documents.size() >= 2 && request.resource.data.documents.size() <= 3);
      allow delete: if false;
    }
    match /services/{serviceId} {
      allow read: if resource.data.status == 'active' || (active() && (resource.data.sellerId == request.auth.uid || admin()));
      allow create: if seller() && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status in ['active','draft','paused']
        && text(request.resource.data.title,200) && text(request.resource.data.description,10000)
        && request.resource.data.price is number && request.resource.data.price > 0 && request.resource.data.price <= 10000000
        && request.resource.data.rating == 0 && request.resource.data.reviewCount == 0
        && request.resource.data.orders == 0 && request.resource.data.views == 0
        && request.resource.data.sellerVerified == false
        && !request.resource.data.keys().hasAny(['badge','badgeIcon']);
      allow update: if admin() || (seller() && resource.data.sellerId == request.auth.uid
        && changedOnly(['title','description','imageUrl','category','categoryIcon','price','priceUnit','type','tags','district','status','updatedAt'])
        && request.resource.data.status in ['active','paused','draft']
        && request.resource.data.price is number && request.resource.data.price > 0 && request.resource.data.price <= 10000000);
      allow delete: if admin() || (seller() && resource.data.sellerId == request.auth.uid);
    }
    match /categories/{id} { allow read: if true; allow write: if admin(); }
    match /settings/platform { allow read: if true; allow write: if admin(); }
    match /jobRequests/{id} {
      allow read: if active(); // Contains the poster's contact details.
      allow create: if active() && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'open' && request.resource.data.responses == 0
        && request.resource.data.verified == profile().verified
        && text(request.resource.data.title,200) && text(request.resource.data.description,5000);
      allow update: if admin() || (active() && resource.data.authorId == request.auth.uid && changedOnly(['status']) && request.resource.data.status in ['open','closed']);
      allow delete: if admin() || (active() && resource.data.authorId == request.auth.uid);
      match /responses/{uid} {
        allow read: if self(uid) || (active() && get(/databases/$(database)/documents/jobRequests/$(id)).data.authorId == request.auth.uid) || admin();
        allow create: if self(uid) && seller() && text(request.resource.data.message,2000);
        allow update, delete: if false;
      }
    }
    match /bookings/{id} {
      function party() { return active() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid); }
      function bookingService() { return get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data; }
      function transition() {
        return (resource.data.status == 'pending' && request.resource.data.status in ['confirmed','cancelled'])
          || (resource.data.status == 'confirmed' && request.resource.data.status in ['in_progress','cancelled'])
          || (resource.data.status == 'in_progress' && request.resource.data.status in ['completed','cancelled']);
      }
      allow read: if party() || admin();
      allow create: if active() && request.resource.data.keys().hasOnly(['id','serviceId','serviceTitle','category','categoryIcon','vendorName','vendorPhone','vendorInitial','vendorVerified','customerName','customerPhone','date','time','notes','extraData','price','district','status','createdAt','updatedAt','buyerId','sellerId','statusHistory'])
        && request.resource.data.id == id && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid && request.resource.data.sellerId == bookingService().sellerId
        && get(/databases/$(database)/documents/users/$(request.resource.data.sellerId)).data.get('status','active') != 'suspended'
        && get(/databases/$(database)/documents/users/$(request.resource.data.sellerId)).data.get('availability','available') != 'away'
        && bookingService().status == 'active' && request.resource.data.price == bookingService().price
        && request.resource.data.serviceTitle == bookingService().title && request.resource.data.vendorName == bookingService().sellerName
        && request.resource.data.status == 'pending'
        && text(request.resource.data.customerName,100) && text(request.resource.data.customerPhone,30)
        && request.resource.data.date is string && request.resource.data.date.size() == 10;
      allow update: if (party() || admin()) && transition()
        && changedOnly(['status','updatedAt','statusNote','cancelReason','completedAt','statusHistory'])
        && (admin() || resource.data.sellerId == request.auth.uid || (request.resource.data.status == 'cancelled' && resource.data.status in ['pending','confirmed']))
        // Paid cancellation must go through refund handling, not silently cancel funds.
        && (!exists(/databases/$(database)/documents/payments/$(id)) || get(/databases/$(database)/documents/payments/$(id)).data.status != 'paid' || request.resource.data.status != 'cancelled');
      allow delete: if false;
    }
    match /disputes/{id} {
      function booking() { return get(/databases/$(database)/documents/bookings/$(request.resource.data.orderId)).data; }
      allow read: if active() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || admin());
      allow create: if active() && request.resource.data.buyerId == request.auth.uid
        && booking().buyerId == request.auth.uid && request.resource.data.sellerId == booking().sellerId
        && request.resource.data.amount == booking().price && request.resource.data.status == 'open'
        && request.resource.data.messages == [] && text(request.resource.data.description,5000);
      allow update: if (admin() && changedOnly(['messages','status','resolution']))
        || (active() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid)
          && changedOnly(['messages']) && request.resource.data.messages is list
          && request.resource.data.messages.size() == resource.data.messages.size() + 1
          && request.resource.data.messages.hasAll(resource.data.messages)
          && request.resource.data.messages[request.resource.data.messages.size()-1].from == (resource.data.buyerId == request.auth.uid ? 'buyer' : 'seller')
          && text(request.resource.data.messages[request.resource.data.messages.size()-1].text,2000));
      allow delete: if false;
    }
    match /conversations/{id} {
      function party() { return active() && request.auth.uid in resource.data.participants; }
      allow read: if party();
      allow create: if active() && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid
        && get(/databases/$(database)/documents/services/$(request.resource.data.serviceId)).data.sellerId == request.resource.data.sellerId
        && request.resource.data.participants == [request.resource.data.buyerId,request.resource.data.sellerId]
        && request.resource.data.unreadBuyer == 0 && request.resource.data.unreadSeller == 0;
      allow update: if party() && changedOnly(['lastMessage','lastAt','unreadBuyer','unreadSeller','buyerOnline','sellerOnline']);
      allow delete: if false;
      match /messages/{messageId} {
        function parent() { return get(/databases/$(database)/documents/conversations/$(id)).data; }
        allow read: if active() && request.auth.uid in parent().participants;
        allow create: if active() && request.auth.uid in parent().participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.from == (parent().buyerId == request.auth.uid ? 'buyer' : 'seller')
          && text(request.resource.data.text,4000)
          && request.resource.data.keys().hasOnly(['senderId','from','text','read','conversationId','sentAt']);
        allow update, delete: if false;
      }
    }
    match /feedPosts/{id} {
      allow read: if true;
      allow create: if active() && request.resource.data.authorId == request.auth.uid
        && text(request.resource.data.title,200) && text(request.resource.data.description,5000)
        && request.resource.data.likes == 0 && request.resource.data.comments == 0 && request.resource.data.shares == 0;
      allow update: if active() && resource.data.authorId == request.auth.uid && changedOnly(['title','description','imageUrl','price']);
      allow delete: if active() && (resource.data.authorId == request.auth.uid || admin());
      match /likes/{uid} { allow read: if active(); allow create, delete: if self(uid) && active(); allow update: if false; }
      match /comments/{commentId} {
        allow read: if true;
        allow create: if active() && request.resource.data.authorId == request.auth.uid && text(request.resource.data.text,2000);
        allow delete: if active() && (resource.data.authorId == request.auth.uid || admin());
      }
    }
    match /reviews/{id} {
      function booking() { return get(/databases/$(database)/documents/bookings/$(id)).data; }
      allow read: if true;
      allow create: if active() && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.bookingId == id && booking().buyerId == request.auth.uid
        && booking().status == 'completed' && request.resource.data.serviceId == booking().serviceId
        && request.resource.data.sellerId == booking().sellerId
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && !request.resource.data.keys().hasAny(['reply','repliedAt']);
      allow update: if active() && resource.data.sellerId == request.auth.uid && changedOnly(['reply','repliedAt']) && text(request.resource.data.reply,2000);
      allow delete: if admin();
    }
    match /submissions/{id} {
      allow create: if active() && request.resource.data.authorId == request.auth.uid
        && request.resource.data.kind in ['contact','overseas','emergency','newsletter','account_deletion','account_deactivation']
        && request.resource.data.status == 'open' && request.resource.data.payload is map
        && request.resource.data.keys().hasOnly(['kind','authorId','authorName','email','payload','status','createdAt']);
      allow read: if admin() || (active() && resource.data.authorId == request.auth.uid);
      allow update: if admin() && changedOnly(['status','notes','updatedAt']) && request.resource.data.status in ['open','in_progress','closed'];
      allow delete: if false;
    }
    // Hotel and urgent capability writes run through authenticated server operations.
    match /hotelProperties/{uid} {
      allow read: if resource.data.status == 'approved' || self(uid) || admin();
      allow write: if false;
      match /{kind}/{itemId} {
        allow read: if self(uid) || admin() || (kind in ['rooms','addons','packages']
          && get(/databases/$(database)/documents/hotelProperties/$(uid)).data.status == 'approved'
          && resource.data.active == true);
        allow write: if false;
      }
    }
    match /hotelRequests/{id} {
      allow read: if active() && (resource.data.buyerId == request.auth.uid || resource.data.ownerId == request.auth.uid || admin());
      allow write: if false;
      match /quotes/{version} {
        allow read: if active() && (get(/databases/$(database)/documents/hotelRequests/$(id)).data.buyerId == request.auth.uid || get(/databases/$(database)/documents/hotelRequests/$(id)).data.ownerId == request.auth.uid || admin());
        allow write: if false;
      }
    }
    match /businessReviews/{id} { allow read: if admin() || (active() && (id == 'hotel_' + request.auth.uid || id == 'emergency_' + request.auth.uid)); allow write: if false; }
    match /emergencyApplications/{uid} { allow read: if self(uid) || admin(); allow write: if false; }
    match /emergencyProviders/{uid} { allow read: if true; allow write: if false; }
    match /payments/{id} {
      allow get: if active() && (admin() || get(/databases/$(database)/documents/bookings/$(id)).data.buyerId == request.auth.uid || get(/databases/$(database)/documents/bookings/$(id)).data.sellerId == request.auth.uid);
      allow list: if active() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid || admin());
      allow write: if false;
    }
    match /balances/{uid} { allow read: if self(uid) || admin(); allow write: if false; }
    match /payouts/{id} { allow read: if active() && (resource.data.sellerId == request.auth.uid || admin()); allow write: if false; }
  }
}
