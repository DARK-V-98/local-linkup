rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuth() && getUserData().role == 'admin';
    }

    function isSeller() {
      return isAuth() && getUserData().role == 'seller';
    }

    // ─── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Anyone can read basic profiles (for service listings)
      allow read: if isAuth();
      // Only the user themselves or admin can write
      allow create: if isAuth() && isSelf(uid);
      allow update: if isAuth() && (isSelf(uid) || isAdmin());
      allow delete: if isAdmin();

      // Saved services subcollection
      match /saved/{serviceId} {
        allow read, write: if isAuth() && isSelf(uid);
      }
    }

    // ─── Services ─────────────────────────────────────────────────────────────
    match /services/{serviceId} {
      // Public read (browse page)
      allow read: if true;
      // Sellers can create their own services
      allow create: if isSeller()
                    && request.resource.data.sellerId == request.auth.uid;
      // Only the owning seller or admin can update/delete
      allow update: if isAuth()
                    && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isAuth()
                    && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // ─── Bookings ─────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Buyer or seller involved can read
      allow read: if isAuth()
                  && (resource.data.buyerId == request.auth.uid
                      || resource.data.sellerId == request.auth.uid
                      || isAdmin());
      // Any authenticated user can create (as buyer)
      allow create: if isAuth()
                    && request.resource.data.buyerId == request.auth.uid;
      // Only the seller or admin can update status
      allow update: if isAuth()
                    && (resource.data.sellerId == request.auth.uid
                        || resource.data.buyerId == request.auth.uid
                        || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Conversations ────────────────────────────────────────────────────────
    match /conversations/{convoId} {
      // Only participants can read conversations
      allow read: if isAuth()
                  && request.auth.uid in resource.data.participants;
      // Any authenticated user can create a conversation
      allow create: if isAuth()
                    && request.auth.uid in request.resource.data.participants;
      // Only participants can update (last message, unread counts, online status)
      allow update: if isAuth()
                    && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuth()
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow create: if isAuth()
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow update: if false; // Messages are immutable
        allow delete: if isAdmin();
      }
    }

    // ─── Feed posts ───────────────────────────────────────────────────────────
    match /feedPosts/{postId} {
      allow read: if true;
      allow create: if isAuth()
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuth()
                    && (resource.data.authorId == request.auth.uid || isAdmin())
                    || request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['likes', 'shares', 'comments']); // Allow reactions from anyone
      allow delete: if isAuth()
                    && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth();
        allow delete: if isAuth()
                      && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // ─── Reviews ──────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth()
                    && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuth()
                    && (resource.data.sellerId == request.auth.uid // seller reply
                        || isAdmin());
      allow delete: if isAdmin();
    }

  }
}
