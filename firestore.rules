rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // The owner account. Derived from the verified Firebase Auth token, NOT
    // from the user document — a client cannot forge its own token email.
    function isDeveloper() {
      return isAuth() && request.auth.token.email == 'tikfese@gmail.com';
    }

    // Developer outranks admin and is allowed anywhere admin is.
    function isAdmin() {
      return isDeveloper() || (isAuth() && getUserData().role == 'admin');
    }

    function isSeller() {
      return isAuth() && getUserData().role == 'seller';
    }

    // True when a write leaves the privilege fields untouched. Without this,
    // any signed-in user could promote themselves by writing role:'admin'
    // to their own profile.
    function keepsPrivileges() {
      return !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'verified'])
             || isDeveloper()
             || (request.resource.data.role == resource.data.role
                 && request.resource.data.verified == resource.data.verified);
    }

    // ─── Users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Anyone can read basic profiles (for service listings)
      allow read: if isAuth();
      // A new profile may not grant itself elevated privileges. The owner
      // email is the sole exception — that is how developer access bootstraps.
      allow create: if isAuth() && isSelf(uid)
                    && (isDeveloper()
                        || (request.resource.data.role in ['buyer', 'seller']
                            && request.resource.data.verified == false));
      // Users edit their own profile but cannot change role or verified status;
      // admins and the developer can.
      allow update: if isAuth()
                    && ((isSelf(uid) && keepsPrivileges()) || isAdmin());
      allow delete: if isAdmin();

      // Saved services subcollection
      match /saved/{serviceId} {
        allow read, write: if isAuth() && isSelf(uid);
      }
    }

    // ─── Services ─────────────────────────────────────────────────────────────
    match /services/{serviceId} {
      // Public read (browse page)
      allow read: if true;
      // Sellers can create their own services
      allow create: if isSeller()
                    && request.resource.data.sellerId == request.auth.uid;
      // Only the owning seller or admin can update/delete
      allow update: if isAuth()
                    && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isAuth()
                    && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // ─── Categories ───────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      // Public read — the home page and seller registration need these
      allow read: if true;
      // Only admins curate the category list
      allow write: if isAdmin();
    }

    // ─── Job requests (the "post a job" board) ────────────────────────────────
    match /jobRequests/{requestId} {
      // Public board — sellers browse it to find work
      allow read: if true;
      // Guests may post a request; a signed-in poster must own the record
      allow create: if !("authorId" in request.resource.data)
                    || (isAuth() && request.resource.data.authorId == request.auth.uid);
      // The poster or an admin can edit/close it. Sellers responding may only
      // bump the response counter.
      allow update: if (isAuth() && (resource.data.authorId == request.auth.uid || isAdmin()))
                    || request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['responses']);
      allow delete: if isAuth()
                    && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ─── Bookings ─────────────────────────────────────────────────────────────
    match /bookings/{bookingId} {
      // Buyer or seller involved can read
      allow read: if isAuth()
                  && (resource.data.buyerId == request.auth.uid
                      || resource.data.sellerId == request.auth.uid
                      || isAdmin());
      // Any authenticated user can create (as buyer)
      allow create: if isAuth()
                    && request.resource.data.buyerId == request.auth.uid;
      // Only the seller or admin can update status
      allow update: if isAuth()
                    && (resource.data.sellerId == request.auth.uid
                        || resource.data.buyerId == request.auth.uid
                        || isAdmin());
      allow delete: if isAdmin();
    }

    // ─── Disputes ─────────────────────────────────────────────────────────────
    match /disputes/{disputeId} {
      // Only the two parties and admins can see a dispute
      allow read: if isAuth()
                  && (resource.data.buyerId == request.auth.uid
                      || resource.data.sellerId == request.auth.uid
                      || isAdmin());
      // A buyer raises the dispute against their own booking
      allow create: if isAuth()
                    && request.resource.data.buyerId == request.auth.uid;
      // Parties can add messages; only admins change status or resolution
      allow update: if isAdmin()
                    || (isAuth()
                        && (resource.data.buyerId == request.auth.uid
                            || resource.data.sellerId == request.auth.uid)
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['messages']));
      allow delete: if isAdmin();
    }

    // ─── Conversations ────────────────────────────────────────────────────────
    match /conversations/{convoId} {
      // Only participants can read conversations
      allow read: if isAuth()
                  && request.auth.uid in resource.data.participants;
      // Any authenticated user can create a conversation
      allow create: if isAuth()
                    && request.auth.uid in request.resource.data.participants;
      // Only participants can update (last message, unread counts, online status)
      allow update: if isAuth()
                    && request.auth.uid in resource.data.participants;
      allow delete: if isAdmin();

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuth()
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow create: if isAuth()
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow update: if false; // Messages are immutable
        allow delete: if isAdmin();
      }
    }

    // ─── Feed posts ───────────────────────────────────────────────────────────
    match /feedPosts/{postId} {
      allow read: if true;
      allow create: if isAuth()
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuth()
                    && (resource.data.authorId == request.auth.uid || isAdmin())
                    || request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['likes', 'shares', 'comments']); // Allow reactions from anyone
      allow delete: if isAuth()
                    && (resource.data.authorId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuth();
        allow delete: if isAuth()
                      && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // ─── Reviews ──────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth()
                    && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAuth()
                    && (resource.data.sellerId == request.auth.uid // seller reply
                        || isAdmin());
      allow delete: if isAdmin();
    }

  }
}
